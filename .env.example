# ArchitectAI Environment Configuration
# Copy this file to .env and fill in your values

# Database (PostgreSQL for Docker, SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./data/architectai.db
# DATABASE_URL=postgresql+asyncpg://architectai:architectai@localhost:5432/architectai

# Redis (required for SSE streaming; falls back gracefully if unavailable)
REDIS_URL=redis://localhost:6379/0

# OpenAI API Key (required for code generation)
OPENAI_API_KEY=sk-your-key-here

# Application
SECRET_KEY=change-me-to-a-random-string
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Optional: pgvector extension for semantic search
PGVECTOR_EXTENSION=false
